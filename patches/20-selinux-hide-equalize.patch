+/*
+ * selinux_setprocattr() A/B timing equalization.
+ *
+ * Side-channel probes (Duck / Maple) write two same-length payloads to
+ * /proc/thread-self/attr/current and compare the cost of the two writes:
+ *
+ *   A = "u:r:__selinux_hide_probe_invalid__:s0"   (unknown type)
+ *   B = "\n:r:__selinux_hide_probe_invalid__:s0"  (first byte is a newline)
+ *
+ * Stock returns -EINVAL for both, but through different work: A fails in
+ * security_context_to_sid(), B skips conversion because of the leading
+ * newline and only fails on the empty SID after prepare_creds().  The hook
+ * kept that split, so A paid a backup-policy parse while B paid a cred
+ * round-trip; here that became a stable +51..+104 ns A-slower signal.
+ *
+ * The guard below removes the split.  The payload is copied once (value is
+ * never written to), a trailing newline is stripped, and the type field - the
+ * only field the two payloads share byte for byte - is looked up in the same
+ * policy the conversion uses.  Both payloads then execute the same
+ * instructions and the same single symtab probe, and both return -EINVAL
+ * before any cred is allocated.  A zero return only means "let the real
+ * conversion decide": user, role, MLS and role/type validity are still
+ * checked by security_context_to_sid_live(), and the EAGAIN dual parse is
+ * unchanged, so a valid context still changes the current SID as before.
+ */
+#define KSU_SETPROC_CTX_MAX 4096
+#define KSU_SETPROC_CTX_STACK 256
+#define KSU_SETPROC_TYPE_MAX 128
+
+struct ksu_setproc_ctx {
+    char *p;
+    bool heap;
+    char stack[KSU_SETPROC_CTX_STACK];
+};
+
+static void ksu_setproc_ctx_release(struct ksu_setproc_ctx *ctx)
+{
+    if (ctx->heap)
+        kfree(ctx->p);
+}
+
+/*
+ * Copy the attribute payload into private memory.  value belongs to the
+ * caller and may be read-only, so it is never modified, and nothing here
+ * depends on value being NUL terminated.  A single trailing newline is
+ * stripped; the stripped length is reported so write() keeps stock's return
+ * value.
+ */
+static int ksu_setproc_ctx_prepare(const void *value, size_t size, struct ksu_setproc_ctx *ctx, u32 *ctx_len)
+{
+    if (!size || !value)
+        return -EINVAL;
+
+    if (size < sizeof(ctx->stack)) {
+        ctx->p = ctx->stack;
+        ctx->heap = false;
+    } else {
+        ctx->p = kmalloc(size + 1, GFP_KERNEL);
+        if (!ctx->p)
+            return -ENOMEM;
+        ctx->heap = true;
+    }
+
+    memcpy(ctx->p, value, size);
+
+    if (ctx->p[size - 1] == '\n')
+        size--;
+    ctx->p[size] = '\0';
+
+    if (!size) {
+        ksu_setproc_ctx_release(ctx);
+        return -EINVAL;
+    }
+
+    *ctx_len = (u32)size;
+    return 0;
+}
+
+/*
+ * Validate the type field (third ':' separated field) against the policy used
+ * by the conversion below.  This is the cheap half of string_to_context_struct()
+ * and the only check both probe payloads can reach identically.  Unknown and
+ * attribute types are rejected with the same -EINVAL the full parser returns.
+ */
+static int ksu_setproc_type_gate(const char *scontext, u32 scontext_len, struct selinux_policy *policy)
+{
+    const char *p = scontext, *end = scontext + scontext_len;
+    struct type_datum *typdatum;
+    char type[KSU_SETPROC_TYPE_MAX];
+    size_t len = 0;
+    int i;
+
+    for (i = 0; i < 2; i++) {
+        while (p < end && *p != ':')
+            p++;
+        if (p == end)
+            return -EINVAL;
+        p++;
+    }
+
+    while (p < end && *p != ':' && len < sizeof(type) - 1)
+        type[len++] = *p++;
+    if (!len)
+        return -EINVAL;
+    if (p < end && *p != ':')
+        return 0; /* overlong type name: leave the decision to the full parser */
+    type[len] = '\0';
+
+    typdatum = symtab_search(&policy->policydb.p_types, type);
+    if (!typdatum || typdatum->attribute)
+        return -EINVAL;
+
+    return 0;
+}
+
+/*
+ * Normalize, guard and convert in one place, so that every failure before
+ * prepare_creds() is returned from here with the payload-independent cost.
+ * On success *sid is the SID to commit and *ctx_len is the length stock would
+ * have returned from write().
+ */
+static int ksu_setproc_context_lookup(const void *value, size_t size, struct selinux_policy *policy, u32 *ctx_len,
+                                      u32 *sid)
+{
+    struct ksu_setproc_ctx ctx;
+    int error;
+
+    error = ksu_setproc_ctx_prepare(value, size, &ctx, ctx_len);
+    if (error)
+        return error;
+
+    error = ksu_setproc_type_gate(ctx.p, *ctx_len, policy);
+    if (!error) {
+        error = security_context_to_sid_live(ctx.p, *ctx_len, sid);
+        if (error == -EAGAIN) {
+            // stale type mark, use the dual parse
+            u32 tmp_sid = 0;
+            int error2;
+
+            error2 = security_context_to_sid_with_policy(policy, ctx.p, *ctx_len, &tmp_sid, SECSID_NULL, GFP_KERNEL,
+                                                         sid, &error);
+            if (error2 || error)
+                error = error2 ?: error;
+        }
+    }
+
+    ksu_setproc_ctx_release(&ctx);
+    return error;
+}
